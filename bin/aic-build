#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * bin/aic-build: write the build-time manifests (`composer run build`); with
 * `--check`, compare them with the committed files instead (gate:24).
 *
 * AIC compiles its wiring at build time, never at boot. build/surface.json
 * (#26) holds every route with its method, path, handler and kind, and every
 * console command with its kind, so an agent can read the app's whole surface
 * in one file. The routes come from config/routes.php and the commands from
 * App\ConsoleCommands; the database is never opened, because PdoDatabase
 * connects on its first query. Each component template, `X.tpl` under app/ or
 * framework/src/, compiles to `XTemplate.php` beside it (#36), and theme/*.css
 * builds into public/assets/aic.css (#39).
 */

use AIC\Database\Domain\DatabaseConfig;
use AIC\Database\Infrastructure\PdoDatabase;
use AIC\Routing\Domain\RouteTable;
use App\AppJobs;
use App\AppPlugins;
use App\AppProvider;
use App\ConsoleCommands;
use Gates\Application\SurfaceManifest;
use Gates\Application\TemplateBuild;
use Gates\Application\TemplateCompiler;
use Gates\Application\TemplateParser;
use Gates\Application\ThemeBuild;

require __DIR__ . '/../vendor/autoload.php';

$routes = require __DIR__ . '/../config/routes.php';
$databaseConfig = require __DIR__ . '/../config/database.php';

if (!$routes instanceof RouteTable || !$databaseConfig instanceof DatabaseConfig) {
    fwrite(\STDERR, "aic-build: config/routes.php or config/database.php returned the wrong type.\n");

    exit(1);
}

$consoleCommands = new ConsoleCommands(new PdoDatabase($databaseConfig), new AppPlugins(new AppProvider()));
$root = dirname(__DIR__);
$templateBuild = new TemplateBuild(new TemplateParser(), new TemplateCompiler(), [$root . '/app' => 'App\\', $root . '/framework/src' => 'AIC\\']);

try {
    $outputs = [
        $root . '/build/surface.json' => (new SurfaceManifest())->json($routes->routes(), $consoleCommands->byName(), (new AppJobs())->byName()),
        $root . '/public/assets/aic.css' => (new ThemeBuild($root . '/theme'))->stylesheet(),
    ] + $templateBuild->classes();
} catch (InvalidArgumentException $invalidArgumentException) {
    fwrite(\STDERR, 'aic-build: ' . $invalidArgumentException->getMessage() . "\n");

    exit(1);
}

$arguments = $argv ?? [];

if (($arguments[1] ?? '') === '--check') {
    $stale = array_keys(array_filter($outputs, static fn (string $output, string $file): bool => (is_file($file) ? file_get_contents($file) : '') !== $output, \ARRAY_FILTER_USE_BOTH));

    if ($stale !== []) {
        fwrite(\STDERR, 'gate:24 — stale: ' . implode(', ', array_map(static fn (string $file): string => substr($file, strlen($root) + 1), $stale)) . "; run composer run build and commit them.\n");

        exit(1);
    }

    fwrite(\STDOUT, 'gate:24 — build outputs are fresh: ' . count($routes->routes()) . ' routes, ' . count($consoleCommands->byName()) . ' commands, the theme, ' . (count($outputs) - 2) . " templates.\n");

    exit(0);
}

foreach ($outputs as $file => $output) {
    if (!is_dir(dirname($file)) && !mkdir(dirname($file), 0o755, true)) {
        fwrite(\STDERR, 'aic-build: cannot create ' . dirname($file) . ".\n");

        exit(1);
    }

    file_put_contents($file, $output);
}

fwrite(\STDOUT, 'aic-build: wrote build/surface.json, public/assets/aic.css and ' . (count($outputs) - 2) . " templates.\n");

exit(0);
