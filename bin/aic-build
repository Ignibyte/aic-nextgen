#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * bin/aic-build: write the build-time manifests (`composer run build`); with
 * `--check`, compare them with the committed files instead (gate:24).
 *
 * AIC compiles its wiring at build time, never at boot. build/surface.json
 * (#26) holds every route with its method, path, handler and kind, every
 * console command, job and schedule, and the modules, so an agent can read the
 * app's whole surface in one file. The commands, jobs and schedules come from
 * the console kernel (#93); the database is never opened, because PdoDatabase
 * connects on its first query. A component template compiles to
 * `XTemplate.php`: beside itself under framework/src/ (#36), into
 * modules/<m>/src/Component/ from modules/<m>/templates/components/, and from
 * templates/layouts/ beside the one module component of its name (#93).
 * theme/*.css builds into public/assets/aic.css (#39).
 *
 * The modules come first (#92): every modules/<name>/<name>.module.php is read
 * and checked, and the wiring under generated/ is written (or, with --check,
 * compared) before any composition class loads, since those classes load the
 * generated ones. The build owns generated/: a file there that no module
 * generates any more is deleted, and --check calls it stale. The routes are
 * the modules', in the build order the app kernel adds them in, so
 * surface.json lists exactly what the app serves.
 */

use AIC\Config\Domain\AppConfig;
use AIC\Database\Domain\DatabaseConfig;
use AIC\Database\Infrastructure\PdoDatabase;
use AIC\Module\Application\ConsoleKernel;
use AIC\Notification\Domain\MailConfig;
use AIC\Notification\Infrastructure\SmtpTransport;
use AIC\Routing\Application\RouteCollector;
use AIC\Routing\Domain\RoutePatternCompiler;
use App\Generated\ConsoleModules;
use Gates\Application\BuildOutputs;
use Gates\Application\ModuleBuild;
use Gates\Application\SurfaceManifest;
use Gates\Application\TemplateBuild;
use Gates\Application\TemplateCompiler;
use Gates\Application\TemplateParser;
use Gates\Application\TesseraBuild;
use Gates\Application\ThemeBuild;
use Gates\Infrastructure\SystemProcessRunner;

require __DIR__ . '/../vendor/autoload.php';

$appConfig = require __DIR__ . '/../config/app.php';
$databaseConfig = require __DIR__ . '/../config/database.php';
$mailConfig = require __DIR__ . '/../config/mail.php';

if (!$appConfig instanceof AppConfig || !$databaseConfig instanceof DatabaseConfig || !$mailConfig instanceof MailConfig) {
    fwrite(\STDERR, "aic-build: config/app.php, config/database.php or config/mail.php returned the wrong type.\n");

    exit(1);
}

$root = dirname(__DIR__);
$arguments = $argv ?? [];
$checking = ($arguments[1] ?? '') === '--check';
$moduleBuild = new ModuleBuild($root);

try {
    $modules = $moduleBuild->modules();
    $generated = $moduleBuild->files($modules);
} catch (InvalidArgumentException $invalidArgumentException) {
    fwrite(\STDERR, 'aic-build: ' . $invalidArgumentException->getMessage() . "\n");

    exit(1);
}

$buildOutputs = new BuildOutputs($root);

$orphans = $buildOutputs->orphans($root . '/generated', $generated);
$staleGenerated = [...$buildOutputs->stale($generated), ...$orphans];

if ($checking && $staleGenerated !== []) {
    fwrite(\STDERR, 'gate:24 — stale: ' . $buildOutputs->names($staleGenerated) . "; run composer run build and commit them.\n");

    exit(1);
}

if (!$checking) {
    foreach ($generated as $file => $output) {
        if (!is_dir(dirname($file)) && !mkdir(dirname($file), 0o755, true)) {
            fwrite(\STDERR, 'aic-build: cannot create ' . dirname($file) . ".\n");

            exit(1);
        }

        file_put_contents($file, $output);
    }

    foreach ($orphans as $orphan) {
        unlink($orphan);
    }
}

$consoleKernel = new ConsoleKernel(new PdoDatabase($databaseConfig), new SmtpTransport($mailConfig), $mailConfig, new ConsoleModules());
$templateBuild = new TemplateBuild(
    new TemplateParser(),
    new TemplateCompiler(),
    [$root . '/framework/src' => 'AIC\\'],
    $root . '/modules',
    $root . '/templates/layouts',
);

try {
    $routes = $moduleBuild->routes($modules, new RouteCollector(new RoutePatternCompiler()))->table();
    $templates = $templateBuild->classes();
    $tessera = (new TesseraBuild($root, $appConfig->tessera, new SystemProcessRunner()))->files();
    $outputs = [
        $root . '/build/surface.json' => (new SurfaceManifest())->json($routes->routes(), $consoleKernel->commands(), $consoleKernel->jobs(), $consoleKernel->schedules(), $modules),
        $root . '/public/assets/aic.css' => (new ThemeBuild($root . '/theme'))->stylesheet(),
    ] + $templates + $tessera;
} catch (InvalidArgumentException|RuntimeException $exception) {
    fwrite(\STDERR, 'aic-build: ' . $exception->getMessage() . "\n");

    exit(1);
}

if ($checking) {
    if ($buildOutputs->stale($outputs) !== []) {
        fwrite(\STDERR, 'gate:24 — stale: ' . $buildOutputs->names($buildOutputs->stale($outputs)) . "; run composer run build and commit them.\n");

        exit(1);
    }

    fwrite(\STDOUT, 'gate:24 — build outputs are fresh: ' . count($routes->routes()) . ' routes, ' . count($consoleKernel->commands()) . ' commands, ' . count($modules) . ' module(s) and their wiring, the theme, ' . count($templates) . ' templates, Tessera ' . $appConfig->tessera->version . ".\n");

    exit(0);
}

foreach ($outputs as $file => $output) {
    if (!is_dir(dirname($file)) && !mkdir(dirname($file), 0o755, true)) {
        fwrite(\STDERR, 'aic-build: cannot create ' . dirname($file) . ".\n");

        exit(1);
    }

    file_put_contents($file, $output);
}

fwrite(\STDOUT, 'aic-build: wrote generated/ (' . count($modules) . ' module(s)), build/surface.json, public/assets/aic.css, ' . count($templates) . ' templates and Tessera ' . $appConfig->tessera->version . ".\n");

exit(0);
