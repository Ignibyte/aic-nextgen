{
    "name": "aic/app",
    "description": "Absolute Insanity, AI (AIAI): AIC's fixture app, the site that holds aic/framework's gates (the demo is the demo-reference tag).",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "aic/framework": "0.1.x-dev",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "aic/gates": "0.1.x-dev",
        "aic/workflow": "0.1.x-dev",
        "roave/security-advisories": "dev-latest"
    },
    "repositories": [
        {
            "type": "path",
            "url": "framework",
            "options": {
                "symlink": true,
                "versions": {
                    "aic/framework": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "gates",
            "options": {
                "symlink": true,
                "versions": {
                    "aic/gates": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "workflow",
            "options": {
                "symlink": true,
                "versions": {
                    "aic/workflow": "0.1.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\Account\\": "modules/account/src/",
            "App\\Generated\\": "build/generated/",
            "App\\Note\\": "modules/note/src/",
            "App\\Scaffold\\": "modules/scaffold/src/",
            "App\\Site\\": "modules/site/src/",
            "App\\Theme\\Components\\": "themes/app/src/Components/",
            "App\\Theme\\Layouts\\": "themes/app/src/Layouts/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "captainhook": {
            "only-enabled": true
        }
    },
    "scripts": {
        "build": "aic-build",
        "gate": [
            "Composer\\Config::disableProcessTimeout",
            "aic-gate"
        ],
        "gate:0": "aic-gate 0",
        "gate:1": "aic-gate 1",
        "gate:10": "aic-gate 10",
        "gate:11": "aic-gate 11",
        "gate:12": "aic-gate 12",
        "gate:13": "aic-gate 13",
        "gate:14": "aic-gate 14",
        "gate:15": "aic-gate 15",
        "gate:16": "aic-gate 16",
        "gate:17": "aic-gate 17",
        "gate:18": "aic-gate 18",
        "gate:19": "aic-gate 19",
        "gate:2": "aic-gate 2",
        "gate:20": "aic-gate 20",
        "gate:21": "aic-gate 21",
        "gate:22": "aic-gate 22",
        "gate:23": "aic-gate 23",
        "gate:24": "aic-gate 24",
        "gate:25": "aic-gate 25",
        "gate:26": "aic-gate 26",
        "gate:27": "aic-gate 27",
        "gate:28": "aic-gate 28",
        "gate:29": "aic-gate 29",
        "gate:3": "aic-gate 3",
        "gate:30": "aic-gate 30",
        "gate:31": "aic-gate 31",
        "gate:32": "aic-gate 32",
        "gate:4": "aic-gate 4",
        "gate:5": "aic-gate 5",
        "gate:6": "aic-gate 6",
        "gate:7": "aic-gate 7",
        "gate:8": "aic-gate 8",
        "gate:9": "aic-gate 9",
        "native:serve": [
            "Composer\\Config::disableProcessTimeout",
            "aic-gate serve"
        ]
    },
    "scripts-descriptions": {
        "build": "Write the build-time outputs under build/: the generated wiring and escaped templates in build/generated/, build/surface.json, build/assets/ (the theme's stylesheets in aic.css, its other assets copied); and the code wiki in docs/wiki/.",
        "gate": "Run every quality gate (aic/gates, vendor/bin/aic-gate) and print one gate-summary line; aic-gate --list names each, and composer run gate:N or aic-gate N runs one.",
        "native:serve": "Build the compiled site and serve it on 127.0.0.1:8090 (or the given port) until interrupted."
    }
}
