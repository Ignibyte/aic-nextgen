{
    "name": "ignibyte/aic-framework",
    "description": "Absolute Insanity, AI (AIAI): the framework, one namespace per system under AIC\\.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "framework",
        "psr-15",
        "native",
        "elephc",
        "server-rendered"
    ],
    "homepage": "https://github.com/Ignibyte/aic-nextgen",
    "support": {
        "issues": "https://github.com/Ignibyte/aic-nextgen/issues",
        "source": "https://github.com/Ignibyte/aic-nextgen"
    },
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AIC\\": "src/"
        }
    },
    "extra": {
        "aic-scaffold": {
            "file-mapping": {
                ".gitignore": {
                    "mode": "append",
                    "path": "scaffold/gitignore"
                },
                "bin/aic": {
                    "mode": "replace",
                    "path": "scaffold/bin/aic"
                },
                "bootstrap/serve.php": {
                    "mode": "replace",
                    "path": "scaffold/bootstrap/serve.php"
                },
                "config/app.php": {
                    "mode": "add-once",
                    "path": "scaffold/config/app.php"
                },
                "config/database.php": {
                    "mode": "add-once",
                    "path": "scaffold/config/database.php"
                },
                "config/mail.php": {
                    "mode": "add-once",
                    "path": "scaffold/config/mail.php"
                },
                "config/profiler.php": {
                    "mode": "add-once",
                    "path": "scaffold/config/profiler.php"
                },
                "config/secret.php": {
                    "mode": "add-once",
                    "path": "scaffold/config/secret.php"
                },
                "public/index.php": {
                    "mode": "replace",
                    "path": "scaffold/public/index.php"
                }
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
