<?php /** @var \AIC\Component\Domain\FilterBar $filterBar */ ?>
<form method="get" action="<?= $filterBar->action ?>" class="aic-filter-bar"><?php foreach ($filterBar->kept as $hiddenInput): ?><input type="hidden" name="<?= $hiddenInput->name ?>" value="<?= $hiddenInput->value ?>"><?php endforeach ?><?php foreach ($filterBar->fields as $filterField): ?><label><?= $filterField->label ?> <?php if ($filterField->options === []): ?><input type="search" name="<?= $filterField->name ?>" value="<?= $filterField->value ?>"><?php else: ?><select name="<?= $filterField->name ?>"><?php foreach ($filterField->options as $filterOption): ?><option value="<?= $filterOption->value ?>"<?php if ($filterOption->value === $filterField->value): ?> selected<?php endif ?>><?= $filterOption->label ?></option><?php endforeach ?></select><?php endif ?></label><?php endforeach ?><button type="submit">Filter</button></form>