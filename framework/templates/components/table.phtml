<?php /** @var \AIC\Component\Domain\Table $table */ ?>
<table class="aic-table"<?php if ($table->poll !== ''): ?> data-poll__5s="<?= $table->poll ?>"<?php endif ?>><?php if ($table->caption !== ''): ?><caption><?= $table->caption ?></caption><?php endif ?><thead><tr><?php foreach ($table->head as $column): ?><th scope="col"><?= $column ?></th><?php endforeach ?></tr></thead><tbody><?php foreach ($table->rows as $tableRow): ?><tr<?php if ($tableRow->state !== ''): ?> class="aic-row-<?= $tableRow->state ?>"<?php endif ?>><?php foreach ($tableRow->cells as $tableCell): ?><td><?php if ($tableCell->href !== ''): ?><a href="<?= $tableCell->href ?>"<?php if ($tableCell->target !== ''): ?> data-target="<?= $tableCell->target ?>"<?php endif ?>><?= $tableCell->text ?></a><?php else: ?><?= $tableCell->text ?><?php endif ?></td><?php endforeach ?></tr><?php endforeach ?></tbody></table>