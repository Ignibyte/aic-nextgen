#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * aic-build (vendor/bin, from aic/gates since #116): write the build-time
 * manifests (`composer run build`); with `--check`, compare them with the
 * committed files instead (gate:24). It runs in the project's root.
 *
 * AIC compiles its wiring at build time, never at boot. build/surface.json
 * (#26) holds every route with its method, path, handler and kind, every
 * console command, job and schedule, and the modules, so an agent can read the
 * app's whole surface in one file. The commands, jobs and schedules come from
 * the console kernel (#93); the database is never opened, because PdoDatabase
 * connects on its first query. The theme config/app.php names (#153) holds
 * every component, layout and asset: each `.phtml` there, plain PHP, is
 * checked by gate:25's grammar, typed, and compiled to its class under
 * `generated/templates/`; the lookup that finds each component's template is
 * generated/ThemeTemplates and its parts (#98), and a template anywhere else
 * is refused. The theme's stylesheets, in path order, build
 * public/assets/aic.css; its other files are copied to their catalog paths.
 * The build owns public/assets/: a file there it would not write is deleted,
 * and --check calls it stale.
 *
 * The modules come first (#92): every modules/<name>/<name>.module.php is read
 * and checked, and the wiring under generated/ is written (or, with --check,
 * compared) before any composition class loads, since those classes load the
 * generated ones. The build owns generated/: a file there that no module
 * generates any more is deleted, and --check calls it stale. The routes are
 * the modules', in the build order the app kernel adds them in, so
 * surface.json lists exactly what the app serves.
 */

use AIC\Component\Domain\ThemeLayout;
use AIC\Component\Domain\ThemePage;
use AIC\Config\Domain\AppConfig;
use AIC\Database\Domain\DatabaseConfig;
use AIC\Database\Infrastructure\PdoDatabase;
use AIC\Module\Application\ConsoleKernel;
use AIC\Notification\Domain\MailConfig;
use AIC\Notification\Infrastructure\SmtpTransport;
use AIC\Routing\Application\RouteCollector;
use AIC\Routing\Domain\RoutePatternCompiler;
use AIC\Workflow\Exception\WorkflowRefusal;
use AIC\Workflow\Infrastructure\WikiKernel;
use App\Generated\ConsoleModules;
use Gates\Application\AssetCatalogBuild;
use Gates\Application\AssetCatalogSource;
use Gates\Application\AtomBuild;
use Gates\Application\BuildOutputs;
use Gates\Application\ModuleBuild;
use Gates\Application\PresentationBuild;
use Gates\Application\ProjectProfile;
use Gates\Application\PublicAssetOrphans;
use Gates\Application\SurfaceManifest;
use Gates\Application\SurfaceTheme;
use Gates\Application\TemplateBuild;
use Gates\Application\TemplateCompiler;
use Gates\Application\TemplatesSource;
use Gates\Application\TesseraBuild;
use Gates\Application\ThemeHtmlSource;
use Gates\Application\ThemeLayoutsSource;
use Gates\Application\ThemePageSource;
use Gates\Application\WebPresentationSource;
use Gates\Domain\GateProfile;
use Gates\Infrastructure\ProjectConfig;
use Gates\Infrastructure\ProjectRoot;
use Gates\Infrastructure\SystemProcessRunner;
use Gates\Phpmd\RuleRegistration;
use Gates\Sniffs\SniffRegistration;
use Gates\Templates\PlainTemplateReader;

require __DIR__ . '/project.php';

$root = (new ProjectRoot())->path();
try {
    $projectConfig = new ProjectConfig();
    $appConfig = $projectConfig->read($root . '/config/app.php', AppConfig::class);
    $databaseConfig = $projectConfig->read($root . '/config/database.php', DatabaseConfig::class);
    $mailConfig = $projectConfig->read($root . '/config/mail.php', MailConfig::class);
} catch (RuntimeException $runtimeException) {
    fwrite(\STDERR, 'aic-build: ' . $runtimeException->getMessage() . "\n");
    exit(1);
}

$arguments = $argv ?? [];
$checking = ($arguments[1] ?? '') === '--check';
$moduleBuild = new ModuleBuild($root);
try {
    $atoms = (new AtomBuild(new PlainTemplateReader(), $root))->files();
    $modules = $moduleBuild->modules();
    $presentation = (new PresentationBuild($root))->plan($appConfig->theme);
    $templateBuild = new TemplateBuild(new PlainTemplateReader(), new TemplateCompiler(), $root, $presentation);
    $templates = $templateBuild->templates();
    $lookups = [];
    $adapters = [];

    // Layouts render through the generated adapters, never the lookup (#154).
    foreach ($presentation->templates as $binding) {
        if ($binding->transparent()) {
            continue;
        }

        $lookups[$binding->component] = $binding->generated;
    }

    $tessera = (new TesseraBuild($root, $appConfig->tessera, new SystemProcessRunner()))->files();
    $assetCatalog = (new AssetCatalogBuild($root))->plan($tessera, $presentation->theme);
    $generated = $moduleBuild->files($modules) + $templates + $atoms;
    $theme = $presentation->theme;
    $generated[$root . '/generated/Presentation.php'] = (new WebPresentationSource())->file($theme);

    if ($theme !== null) {
        $themeLayoutsSource = new ThemeLayoutsSource();
        $generated[$root . '/generated/ThemeLayouts.php'] = $themeLayoutsSource->layouts($theme, $appConfig->tessera->scriptPath());
        $generated[$root . '/generated/ThemePageTemplate.php'] = (new ThemePageSource())->pageTemplate($theme);
        $generated[$root . '/generated/ThemeHtmlTemplate.php'] = (new ThemeHtmlSource())->htmlTemplate($theme);
        $layoutNames = $themeLayoutsSource->layoutNames($theme);

        if ($layoutNames !== null) {
            $generated[$root . '/generated/ThemeLayoutName.php'] = $layoutNames;
        }

        $adapters[ThemeLayout::class] = 'App\\Generated\\ThemeHtmlTemplate';
        $adapters[ThemePage::class] = 'App\\Generated\\ThemePageTemplate';
    }

    foreach ((new AssetCatalogSource())->files($assetCatalog->assets) as $file => $source) {
        $generated[$root . '/generated/' . $file] = $source;
    }

    foreach ((new TemplatesSource())->files($lookups, $adapters) as $file => $source) {
        $generated[$root . '/generated/' . $file] = $source;
    }
    $buildOutputs = new BuildOutputs($root);
    $orphans = [
        ...$buildOutputs->orphans($root . '/generated', $generated, '*.php', true),
        ...$buildOutputs->orphans($root . '/generated', $generated, '*.phtml', true),
        ...($atoms === [] ? [] : [
            ...$buildOutputs->orphans($root . '/framework/src/Component/Application/Templates', $atoms, '*.php', true),
            ...$buildOutputs->orphans($root . '/framework/src/Component/Application/Templates', $atoms, '*.phtml', true),
        ]),
    ];
    $staleGenerated = [...$buildOutputs->stale($generated), ...$orphans];
} catch (InvalidArgumentException|JsonException|RuntimeException $exception) {
    fwrite(\STDERR, 'aic-build: ' . $exception->getMessage() . "\n");

    exit(1);
}

if ($checking && $staleGenerated !== []) {
    fwrite(\STDERR, 'gate:24 — stale: ' . $buildOutputs->names($staleGenerated) . "; run composer run build and commit them.\n");

    exit(1);
}

if (!$checking) {
    foreach ($generated as $file => $output) {
        if (!is_dir(dirname($file)) && !mkdir(dirname($file), 0o755, true)) {
            fwrite(\STDERR, 'aic-build: cannot create ' . dirname($file) . ".\n");

            exit(1);
        }

        file_put_contents($file, $output);
    }

    foreach ($orphans as $orphan) {
        unlink($orphan);
    }
}

$consoleKernel = new ConsoleKernel(new PdoDatabase($databaseConfig), new SmtpTransport($mailConfig), $mailConfig, new ConsoleModules());
try {
    $routes = $moduleBuild->routes($modules, new RouteCollector(new RoutePatternCompiler()))->table();
    $outputs = [
        $root . '/build/surface.json' => (new SurfaceManifest(surfaceTheme: new SurfaceTheme($root, $presentation->theme)))->json($routes->routes(), $consoleKernel->commands(), $consoleKernel->jobs(), $consoleKernel->schedules(), $modules),
    ] + $assetCatalog->outputs + $templates;
    // Only the package's source checkout owns these outputs; an app never writes vendor/.
    if ((new ProjectProfile())->profile($root) === GateProfile::Aic) {
        $outputs[$root . '/gates/config/phpcs-custom.xml'] = (new SniffRegistration())->source();
        $outputs[$root . '/gates/config/phpmd-custom.xml'] = (new RuleRegistration())->source();
    }

} catch (InvalidArgumentException|RuntimeException $exception) {
    fwrite(\STDERR, 'aic-build: ' . $exception->getMessage() . "\n");

    exit(1);
}

$publicAssetOrphans = new PublicAssetOrphans();
$assetOrphans = $publicAssetOrphans->orphans($root . '/public/assets', $outputs);
$stale = [...$buildOutputs->stale($outputs), ...$assetOrphans];

if ($checking) {
    if ($stale !== []) {
        fwrite(\STDERR, 'gate:24 — stale: ' . $buildOutputs->names($stale) . "; run composer run build and commit them.\n");

        exit(1);
    }

    // The code wiki (#108) is checked last, once the surface it reads is known fresh.
    [$wiki, $wikiOrphans] = wiki($root, $buildOutputs);
    $staleWiki = [...$buildOutputs->stale($wiki), ...$wikiOrphans];

    if ($staleWiki !== []) {
        fwrite(\STDERR, 'gate:24 — stale: ' . $buildOutputs->names($staleWiki) . "; run composer run build and commit them.\n");

        exit(1);
    }

    fwrite(\STDOUT, 'gate:24 — build outputs are fresh: ' . count($routes->routes()) . ' routes, ' . count($consoleKernel->commands()) . ' commands, ' . count($modules) . ' module(s) and their wiring, the assets, ' . count($templates) . ' app templates and ' . count($atoms) . ' library outputs, Tessera ' . $appConfig->tessera->version . ', ' . count($wiki) . " wiki pages.\n");

    exit(0);
}

foreach ($outputs as $file => $output) {
    if (!is_dir(dirname($file)) && !mkdir(dirname($file), 0o755, true)) {
        fwrite(\STDERR, 'aic-build: cannot create ' . dirname($file) . ".\n");

        exit(1);
    }

    file_put_contents($file, $output);
}

$publicAssetOrphans->delete($assetOrphans, $root . '/public/assets');

// The code wiki (#108) is written last, from the surface and the tree the build just left.
[$wiki, $wikiOrphans] = wiki($root, $buildOutputs);

foreach ($wiki as $file => $page) {
    if (!is_dir(dirname($file)) && !mkdir(dirname($file), 0o755, true)) {
        fwrite(\STDERR, 'aic-build: cannot create ' . dirname($file) . ".\n");

        exit(1);
    }

    file_put_contents($file, $page);
}

foreach ($wikiOrphans as $orphan) {
    unlink($orphan);
}

fwrite(\STDOUT, 'aic-build: wrote generated/ (' . count($modules) . ' module(s)), build/surface.json, public/assets/, ' . count($templates) . ' app templates and ' . count($atoms) . ' library outputs, Tessera ' . $appConfig->tessera->version . ' and ' . count($wiki) . " wiki pages in docs/wiki/.\n");

exit(0);

/**
 * The code wiki's pages (#108), and the pages under docs/wiki/ it would not write;
 * none when aic/workflow is not installed.
 *
 * @param string       $root         The project's root.
 * @param BuildOutputs $buildOutputs Finds the orphans.
 *
 * @throws InvalidArgumentException When an output directory escapes the project or traverses a symlink.
 *
 * @return array{array<string, string>, list<string>} The pages by absolute path, and the orphans.
 */
function wiki(string $root, BuildOutputs $buildOutputs): array
{
    // The wiki is the workflow's (#108); an app without aic/workflow has none (#116).
    if (!class_exists(WikiKernel::class)) {
        return [[], []];
    }

    try {
        $wiki = (new WikiKernel($root))->pages();
    } catch (WorkflowRefusal $workflowRefusal) {
        fwrite(\STDERR, 'aic-build: the code wiki: ' . $workflowRefusal->getMessage() . "\n");

        exit(1);
    }

    $orphans = [...$buildOutputs->orphans($root . '/docs/wiki', $wiki, '*.md'), ...$buildOutputs->orphans($root . '/docs/wiki/modules', $wiki, '*.md')];

    return [$wiki, $orphans];
}
