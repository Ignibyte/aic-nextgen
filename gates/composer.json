{
    "name": "ignibyte/aic-gates",
    "description": "AIC's gate suite (#116): every gate, the build, the runner and the tools' base configs, for AIC and for an app on it. Dev-only.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "quality",
        "static-analysis",
        "gates",
        "elephc"
    ],
    "homepage": "https://github.com/Ignibyte/aic-nextgen",
    "support": {
        "issues": "https://github.com/Ignibyte/aic-nextgen/issues",
        "source": "https://github.com/Ignibyte/aic-nextgen"
    },
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ignibyte/aic-framework": "^0.1",
        "composer-runtime-api": "^2.2",
        "captainhook/captainhook": "^5.24",
        "captainhook/hook-installer": "^1.0",
        "deptrac/deptrac": "4.7.2",
        "ergebnis/composer-normalize": "2.54.0",
        "ergebnis/phpstan-rules": "2.14.2",
        "icanhazstring/composer-unused": "0.9.6",
        "laravel/pint": "1.32.1",
        "nikic/php-parser": "^5.9",
        "phpat/phpat": "0.12.5",
        "phpmd/phpmd": "2.15.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpdoc-parser": "2.3.6",
        "phpstan/phpstan": "2.3.1",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpstan/phpstan-strict-rules": "2.1.0",
        "rector/rector": "2.7.0",
        "shipmonk/dead-code-detector": "1.4.2",
        "shipmonk/phpstan-rules": "4.4.1",
        "slevomat/coding-standard": "8.22.1",
        "spaze/phpstan-disallowed-calls": "4.15.0",
        "squizlabs/php_codesniffer": "3.13.6",
        "systemsdk/phpcpd": "9.2.0",
        "tomasvotruba/cognitive-complexity": "1.3.0",
        "tomasvotruba/type-coverage": "2.5.1",
        "vimeo/psalm": "6.20.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Gates\\": "src/",
            "Gates\\Architecture\\": "architecture/"
        }
    },
    "bin": [
        "bin/aic-build",
        "bin/aic-gate"
    ],
    "extra": {
        "aic-scaffold": {
            "engine": [
                "bin/aic-gate",
                "init"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
