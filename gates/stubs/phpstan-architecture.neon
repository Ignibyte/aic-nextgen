# gate:9 — phpat (ignibyte/aic-gates' stub, #130), on top of gate:8's configuration: the
# base registers ignibyte/aic-gates' architecture rules, which judge the app's classes.
includes:
    - phpstan.neon
    - vendor/ignibyte/aic-gates/config/phpstan-architecture.neon

parameters:
    # Its own cache beside gate:8's.
    tmpDir: .phpstan-cache/architecture
