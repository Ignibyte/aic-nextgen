# gate:8 — PHPStan (ignibyte/aic-gates' stub, #130): the base holds every setting and
# rule; this file names the app's paths. aic-gate init writes it and gate:30
# holds it to the package's bytes.
includes:
    - vendor/ignibyte/aic-gates/config/phpstan.neon

parameters:
    # The app's own cache: the default under the system temp directory is shared
    # with every project on the machine.
    tmpDir: .phpstan-cache/main
    paths:
        - modules
        - themes
        - build/generated
        - public
        - bootstrap
        - config
        - bin/aic
    excludePaths:
        - vendor
        - storage (?)
        - tools (?)
        - .psalm-cache (?)
        - .rector-cache (?)
