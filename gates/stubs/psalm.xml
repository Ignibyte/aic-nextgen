<?xml version="1.0"?>
<!-- gate:13 — Psalm (aic/gates' stub, #130): the issue handlers and forbidden functions are the package's; this file names the app's files. -->
<!-- Typed config files propagate failures to the HTTP/CLI startup boundary.
     Global-scope exception checking cannot model those includes; method exception contracts remain checked. -->
<psalm
    autoloader="vendor/aic/gates/config/psalm-autoload.php"
    errorLevel="1"
    findUnusedCode="true"
    findUnusedVariablesAndParams="true"
    findUnusedBaselineEntry="true"
    findUnusedPsalmSuppress="true"
    strictBinaryOperands="true"
    rememberPropertyAssignmentsAfterCall="false"
    checkForThrowsDocblock="true"
    checkForThrowsInGlobalScope="false"
    ensureArrayStringOffsetsExist="true"
    ensureArrayIntOffsetsExist="true"
    ensureOverrideAttribute="true"
    reportMixedIssues="true"
    sealAllProperties="true"
    sealAllMethods="true"
    runTaintAnalysis="true"
    usePhpDocPropertiesWithoutMagicCall="true"
    usePhpDocMethodsWithoutMagicCall="true"
    memoizeMethodCallResults="true"
    hoistConstants="true"
    addParamDefaultToDocblockType="true"
    disableSuppressAll="true"
    inferPropertyTypesFromConstructor="true"
    restrictReturnTypes="true"
    cacheDirectory=".psalm-cache"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="modules"/>
        <directory name="generated"/>
        <directory name="public"/>
        <directory name="bootstrap"/>
        <directory name="config"/>
        <file name="bin/aic"/>
        <ignoreFiles>
            <!-- Templates are checked by gate:25, not the class tools. -->
            <directory name="modules/*/templates"/>
            <directory name="vendor"/>
            <directory name=".rector-cache"/>
            <directory name=".psalm-cache"/>
        </ignoreFiles>
    </projectFiles>
    <xi:include href="vendor/aic/gates/config/psalm-issue-handlers.xml"/>
    <!-- The issue handlers and the forbidden functions are aic/gates' (#116). -->
    <xi:include href="vendor/aic/gates/config/psalm-forbidden-functions.xml"/>
</psalm>
