<?xml version="1.0"?>
<ruleset name="AIC"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>AIC strict (gate:11), AIC's own ruleset (#116): the rules are aic/gates' base; this file names AIC's files, cache and root namespaces.</description>

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>

    <file>framework/src</file>
    <file>modules</file>
    <file>generated</file>
    <file>public</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>bin</file>
    <file>gates/bin</file>
    <file>gates/src</file>
    <file>gates/architecture</file>
    <file>workflow/src</file>
    <file>workflow/bin</file>
    <file>workflow/rules</file>
    <file>workflow/probes/sweep</file>

    <!-- Templates are checked by gate:25, not the class tools (Chad, 2026-10-21, #96). -->
    <exclude-pattern>*/modules/*/templates/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>.rector-cache/*</exclude-pattern>
    <exclude-pattern>.psalm-cache/*</exclude-pattern>

    <rule ref="./vendor/aic/gates/config/phpcs.xml"/>

    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="framework/src" value="AIC"/>
                <element key="workflow/src" value="AIC\Workflow"/>
                <element key="modules/account/src" value="App\Account"/>
                <element key="modules/note/src" value="App\Note"/>
                <element key="modules/scaffold/src" value="App\Scaffold"/>
                <element key="modules/site/src" value="App\Site"/>
                <element key="generated" value="App\Generated"/>
                <element key="gates/src" value="Gates"/>
                <element key="gates/architecture" value="Gates\Architecture"/>
            </property>
        </properties>
    </rule>
</ruleset>
