# gate:9 — phpat architecture rules, on top of the gate:8 configuration.
#
# phpat runs only the rule classes registered here with the `phpat.test`
# tag; a rule class that is not listed never runs. gates/architecture is
# analysed here, not in phpstan.neon: only this config registers the rule
# classes, so only here does the dead-code detector see their methods as used.
# Every gate:8 rule still applies to them through the include.
includes:
    - phpstan.neon

parameters:
    paths:
        - gates/architecture
    phpat:
        # Count dependencies on built-in classes: PHPStan's bundled extension
        # stubs make Swoole\ a built-in, and with built-ins ignored the
        # no-Swoole rule could never fail. The vendor rule already allows PHP's
        # standard classes explicitly (Selector::isStandardClass()).
        ignore_built_in_classes: false
        show_rule_names: true

services:
    -
        class: Gates\Architecture\CoreArchitectureTest
        tags:
            - phpat.test
