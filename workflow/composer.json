{
    "name": "ignibyte/aic-workflow",
    "description": "AIC's gated agent workflow (#91): a run per ticket through plan, code, check and complete. Ported from droost-workflow by its author and relicensed MIT. Dev-only.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "agents",
        "workflow",
        "code-index",
        "dev"
    ],
    "homepage": "https://github.com/Ignibyte/aic-nextgen",
    "support": {
        "issues": "https://github.com/Ignibyte/aic-nextgen/issues",
        "source": "https://github.com/Ignibyte/aic-nextgen"
    },
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-posix": "*",
        "ignibyte/aic-framework": "0.1.x-dev",
        "ignibyte/aic-gates": "0.1.x-dev",
        "nikic/php-parser": "^5.9",
        "psr/clock": "^1.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AIC\\Workflow\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
