new file mode 100644
index 0000000..0ca233a
--- /dev/null
+++ w/modules/note/src/Command/NoteStats.php
@@ -0,0 +1,43 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Note\Command;
+
+use AIC\Controller\Contracts\Command;
+use AIC\Controller\Contracts\CommandInput;
+use AIC\Controller\Contracts\CommandResponse;
+use AIC\Controller\Domain\CommandResult;
+use AIC\Database\Contracts\QueryException;
+use App\Note\Repository\NoteRepository;
+use Override;
+
+/**
+ * `aic notes:stats`: how many notes and content pages the demo holds.
+ */
+final readonly class NoteStats implements Command
+{
+    /**
+     * @param NoteRepository $noteRepository The counts.
+     */
+    public function __construct(
+        private NoteRepository $noteRepository,
+    ) {
+    }
+
+    /**
+     * @param CommandInput $commandInput None.
+     *
+     * @throws QueryException When a count fails.
+     *
+     * @return CommandResponse A line per count.
+     */
+    #[Override]
+    public function command(CommandInput $commandInput): CommandResponse
+    {
+        return new CommandResult([
+            'notes: ' . $this->noteRepository->noteCount(),
+            'content pages: ' . $this->noteRepository->contentPageCount(),
+        ], 0);
+    }
+}
