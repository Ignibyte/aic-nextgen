{
    "name": "aic/app",
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Site\\": "modules/site/src/",
            "App\\Shop\\": "modules/shop/src/"
        }
    },
    "scripts": {
        "gate": "aic-gate",
        "gate:8": "aic-gate 8"
    },
    "scripts-descriptions": {
        "gate": "Run every quality gate."
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
