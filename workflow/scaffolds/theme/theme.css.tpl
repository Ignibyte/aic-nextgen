body { margin: 1rem auto; padding: 0 1rem; max-width: 72rem; font-family: system-ui, sans-serif; }
.theme-page { min-width: 0; }
.aic-filter-bar, .aic-pager { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; margin: 1rem 0; }
.aic-description-list { display: grid; grid-template-columns: minmax(8rem, max-content) 1fr; gap: 0.5rem 1rem; margin: 1rem 0; }
.aic-description-list div { display: contents; }
.aic-description-list dd { margin: 0; overflow-wrap: anywhere; }
.aic-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem; border-bottom: 1px solid #ccc; }
.aic-tabs a { padding: 0.4rem 0.75rem; border-bottom: 2px solid transparent; text-decoration: none; }
.aic-tabs a[aria-current="page"] { border-bottom-color: currentColor; }
